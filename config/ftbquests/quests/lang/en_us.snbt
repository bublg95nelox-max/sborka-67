	quest.031FE07F772300F4.title: "Vexing archwood sapling"
	quest.03314113E694FE10.quest_desc: [
		"The Dictionary of spirits is a handbook of what you need to progress trough the mod."
		"by al means, the Dictionary is leading and the quests are not."
	]
	quest.03314113E694FE10.title: "Dictionary of spirits"
	quest.09213B7CC69BABB1.quest_desc: ["Here you'll find some Tips for the modpack"]
	quest.09213B7CC69BABB1.title: "Tips!"
	quest.0B64C0BEEC614007.quest_desc: [
		"Many misc items are not obtainable till you have at least one of them. "
		"To get the first one of many you'll need a wandering trader to spawn."
	]
	quest.0B64C0BEEC614007.title: "Wandering traders"
	quest.0BDDF38F519C44E0.quest_desc: ["Because Phantoms spawn in phase 9 you don't have to deal with them till then."]
	quest.0BDDF38F519C44E0.title: "Disable Phantoms"
	quest.0E5F9BB8FF2BEC90.quest_desc: [
		"In this modpack there are also building stick."
		""
		"they can help you with building large area's quickly."
	]
	quest.0E5F9BB8FF2BEC90.title: "Building Sticks"
	quest.11A48A505A9E949B.title: "Automation"
	quest.131569B94DFCB7A1.quest_desc: [
		"if you ever fall in the void. don't worry!"
		"this modpack has the forgiving void. This means two things:"
		""
		"Fall back down from the sky when falling into the void"
		"Always survive the fall as long as you had full health"
		""
		"so as long as you have full health you'll be fine!"
	]
	quest.131569B94DFCB7A1.title: "Forgiving void"
	quest.1561E634A3EF3FD2.title: "Cocoa Beans"
	quest.18CE88AC4CDB272C.quest_desc: [
		"In This modpack you don't need to be below a block to place one under it."
		"you can place blocks under other blocks just from looking below the block you are standing on."
		""
		"This is very handy for the oneblock since gravel and sand will still drop. so place your first block below so it doesn't fall to the void!"
	]
	quest.18CE88AC4CDB272C.title: "Building tips"
	quest.1C5A69E1BFCA2DE5.quest_desc: [
		"This is the only way to get spawners!"
		""
		"don't forget to have a pickaxe with silk touch so you can pick the spawner up again"
	]
	quest.1C5A69E1BFCA2DE5.title: "Spawner"
	quest.1C89AFB5F0421558.title: "Vannila max"
	quest.1D34641C1FC34525.quest_desc: [
		"To start with projectE, you first want to create a Philosopher's stone."
		""
		"with this item you have a crafting bench always with you with the key \"C\""
		"you can also transmute blocks into another with rightclick"
		""
		"and last but not least, you can turn 4 iron to 1 gold or in reverse. "
	]
	quest.25790BE64911F3B0.title: "This quest line is still work in progress and changes will happen"
	quest.2AA2BA1838700D83.title: "Villager"
	quest.2C458CCF1C0AC776.quest_desc: ["once you have the funnel you can automate it completely by adding it to the top of the one block into a chest/barrel/vault."]
	quest.2FB4478B4CC09D8A.title: "Cow"
	quest.301A4E2E23ECBFDE.quest_desc: [
		"Enchanting from vannila minecraft is great and all but it could be better!"
		""
		"With this mod the max enchanting will go up for every enchant that has levels."
		"For example, Fortune can now go to level 8! for this you do require some stuff."
	]
	quest.301A4E2E23ECBFDE.title: "Where enchanting begins"
	quest.336DC6988D5E1BF7.title: "Bombegranate"
	quest.37106CD84F5BA386.quest_desc: ["For the Gatewaypearl in the crafting recipe, you can use any Gateway pearl."]
	quest.37BF6F507C4114E5.quest_desc: [
		"Getting sick of those creepers blowing up your island?"
		"then you can start claiming your island!"
		"claiming prevents mob and player grieving if they are not allied/part of your party."
	]
	quest.37BF6F507C4114E5.title: "Claiming"
	quest.3E6816253E94BF59.quest_desc: [
		"Thank you so much for playing till the end! "
		"I hope you truly enjoyed the whole modpack."
		""
		"This is my first true modpack where i took the time to balance and create quests for."
		"so if you are not in the discord already do join. "
		"Because i will make more!"
	]
	quest.40DBF4EA3FDCC1A0.quest_desc: [
		"&lWelcome!&r"
		""
		"Thank you so much for trying out my modpack — I really appreciate it!"
		""
		"This pack is still a work in progress, and your feedback is incredibly valuable. If you encounter bugs, have suggestions, or just want to share your thoughts, feel free to reach out by joining my discord server. Your input helps make this modpack better and more enjoyable for everyone."
		""
		"Have fun!"
	]
	quest.40DBF4EA3FDCC1A0.title: "Welcome!"
